#usda 1.0
(
    defaultPrim = "InfeedScannerVisual"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """Visual-only tunnel shroud for the conveyor INFEED port (belt runs through it).

    References the NVIDIA DigitalTwin baggage scanner, the only warehouse asset
    that ships both a tunnel opening and lead-rubber curtains, so the belt reads
    as if it came out of a machine instead of ending in mid air.

    Placement (see ``shroud_config``): the machine is scaled 1.40, its +Y end
    face is parked 0.05 m short of the +Y warehouse wall (world y 23.606), and
    the conveyor itself is shifted +3.55 m north so the belt end sits inside the
    opaque tunnel cabinet.  The half of the machine the belt swallows therefore
    has to disappear -- that is what the ``over`` blocks below do.

    Hidden geometry: the 9 near-end roller pairs (roller/rollercover 10..18,
    local y -1.2135 .. -0.6428) are the exposed roller bed the belt now occupies.
    They are the only per-end separable prims; cartframe / joints / feets /
    feetbase / screws / belt / caps are single meshes spanning the full length
    and cannot be half-hidden, but after the 1.40 scale and the -0.4299 sink they
    all fall inside the conveyor silhouette (max outward reach 0.5116 < the
    conveyor half width 0.5756, highest point 0.762 < the belt plane 0.772), so
    the conveyor body covers them.  The source has 68 Gprims and no instanceable
    prim (verified offline with pxr), so these overs compose normally.

    Physics: the referenced source was audited offline with pxr and carries
    zero PhysicsCollisionAPI / PhysicsRigidBodyAPI / Physx* schemas on all 97
    prims, so this wrapper has nothing to strip and deliberately authors no
    physics attributes at all.  It is spawned through AssetBaseCfg + UsdFileCfg
    without collision_props / rigid_props, which keeps it out of PhysX, out of
    reset, and out of the ZMQ scene-sync inventory.

    Units: like the Tote_B04 wrapper next to this file, the source is authored
    in centimetre units (its own stage declares metersPerUnit = 0.01 and has no
    compensating root scale).  This layer keeps metersPerUnit = 1 to match the
    task stage and lets the task apply the 0.01 authored-unit -> metre factor
    through UsdFileCfg.scale, so the whole scale budget stays in
    ``shroud_config.SHROUD_UNIT_SCALE`` / ``SHROUD_*_DESIGN_SCALE``.

    Measured local geometry after that 0.01 factor (origin = machine centre,
    sitting on the floor plane):
        overall   x +/-0.42161  y +/-1.27424  z 0 .. 1.50206
        roller / belt top surface           z = 0.851355
        curtain opening                     z 0.855965 .. 1.340204, 0.6316 wide
        tunnel cabinet (floor standing)     y +/-0.350363
        near-end roller bed (hidden here)   y -1.2135 .. -0.6428
        far-end roller bed (kept)           y  0.6428 ..  1.2135
    """
)

def Xform "InfeedScannerVisual" (
    prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.1/NVIDIA/Assets/DigitalTwin/Assets/Warehouse/Equipment/Security/BaggageScanner_A/SecurityBaggageScanner_A01_01.usd@
)
{
    over "Geometry"
    {
        over "sm_securitybaggagescanner_a01_roller10_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_roller11_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_roller12_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_roller13_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_roller14_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_roller15_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_roller16_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_roller17_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_roller18_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_rollercover10_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_rollercover11_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_rollercover12_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_rollercover13_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_rollercover14_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_rollercover15_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_rollercover16_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_rollercover17_01"
        {
            token visibility = "invisible"
        }

        over "sm_securitybaggagescanner_a01_rollercover18_01"
        {
            token visibility = "invisible"
        }
    }
}
