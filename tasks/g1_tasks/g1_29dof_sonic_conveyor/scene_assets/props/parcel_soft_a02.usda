            uniform token subdivisionScheme = "none"
            uniform token subsetFamily:materialBind:familyType = "nonOverlapping"

            def GeomSubset "ShippingLabel" (
                prepend apiSchemas = ["MaterialBindingAPI"]
            )
            {
                uniform token elementType = "face"
                uniform token familyName = "materialBind"
                int[] indices = [479, 480, 481, 482, 483, 484, 485, 486, 487, 488, 489, 490, 491, 515, 516, 517, 518, 519, 520, 521, 522, 523, 524, 525, 526, 527, 551, 552, 553, 554, 555, 556, 557, 558, 559, 560, 561, 562, 563, 587, 588, 589, 590, 591, 592, 593, 594, 595, 596, 597, 598, 599, 623, 624, 625, 626, 627, 628, 629, 630, 631, 632, 633, 634, 635, 659, 660, 661, 662, 663, 664, 665, 666, 667, 668, 669, 670, 671, 695, 696, 697, 698, 699, 700, 701, 702, 703, 704, 705, 706, 707, 731, 732, 733, 734, 735, 736, 737, 738, 739, 740, 741, 742, 743, 767, 768, 769, 770, 771, 772, 773, 774, 775, 776, 777, 778, 779, 803, 804, 805, 806, 807, 808, 809, 810, 811, 812, 813, 814, 815, 839, 840, 841, 842, 843, 844, 845, 846, 847, 848, 849, 850, 851, 875, 876, 877, 878, 879, 880, 881, 882, 883, 884, 885, 886, 887, 911, 912, 913, 914, 915, 916, 917, 918, 919, 920, 921, 922, 923, 947, 948, 949, 950, 951, 952, 953, 954, 955, 956, 957, 958, 959, 983, 984, 985, 986, 987, 988, 989, 990, 991, 992, 993, 994, 995, 1019, 1020, 1021, 1022, 1023, 1024, 1025, 1026, 1027, 1028, 1029, 1030, 1031, 1055, 1056, 1057, 1058, 1059, 1060, 1061, 1062, 1063, 1064, 1065, 1066, 1067, 1091, 1092, 1093, 1094, 1095, 1096, 1097, 1098, 1099, 1100, 1101, 1102, 1103, 1127, 1128, 1129, 1130, 1131, 1132, 1133, 1134, 1135, 1136, 1137, 1138, 1139, 1163, 1164, 1165, 1166, 1167, 1168, 1169, 1170, 1171, 1172, 1173, 1174, 1175]
                rel material:binding = </ParcelSoftA02/Looks/ShippingLabel>
            }
        }
    }

    def "Looks"
    {
        def Material "PolyBag"
        {
            token outputs:surface.connect = </ParcelSoftA02/Looks/PolyBag/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                float inputs:clearcoat = 0.25
                float inputs:clearcoatRoughness = 0.25
                color3f inputs:diffuseColor = (0.87, 0.87, 0.88)
                float inputs:ior = 1.46
                float inputs:metallic = 0
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "ShippingLabel"
        {
            token outputs:surface.connect = </ParcelSoftA02/Looks/ShippingLabel/Shader.outputs:surface>

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.92, 0.92, 0.9)
                float inputs:ior = 1.46
                float inputs:metallic = 0
                float inputs:roughness = 0.55
                token outputs:surface
            }
        }
    }

    def Material "GraspPhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 1.1
        float physics:restitution = 0
        float physics:staticFriction = 1.4
        custom token physxMaterial:frictionCombineMode = "multiply"
        custom token physxMaterial:restitutionCombineMode = "min"
    }

    def Mesh "SledCollider" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [
            0, 1, 2, 3,
            4, 7, 6, 5,
            0, 4, 5, 1,
            1, 5, 6, 2,
            2, 6, 7, 3,
            3, 7, 4, 0,
        ]
        # 平底"雪橇"碰撞盒，尺寸=包裹组合包围盒（视觉仍是枕形 Bag，本盒不可见）。
        # 为什么不用 Bag 自身的 convexHull：枕形凸包在带面上滑动时轻微摇晃耗能，
        # 实测比平底纸箱慢 ~3%/程；混排时纸箱逐程追上包裹（一次取件循环 ~0.07 m），
        # 队列间距持续漂移。平底盒让包裹与纸箱的接触几何一致，速度即齐。
        point3f[] points = [
            (-0.2263, -0.176, 0),
            (0.2263, -0.176, 0),
            (0.2263, 0.176, 0),
            (-0.2263, 0.176, 0),
            (-0.2263, -0.176, 0.0968),
            (0.2263, -0.176, 0.0968),
            (0.2263, 0.176, 0.0968),
            (-0.2263, 0.176, 0.0968),
        ]
        bool physics:collisionEnabled = 1
        uniform token physics:approximation = "convexHull"
        float physxCollision:contactOffset = 0.005
        float physxCollision:restOffset = 0
        rel material:binding:physics = </ParcelSoftA02/GraspPhysicsMaterial>
        uniform token subdivisionScheme = "none"
        token visibility = "invisible"
    }
}
