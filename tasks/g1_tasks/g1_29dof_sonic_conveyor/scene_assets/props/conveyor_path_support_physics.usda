#usda 1.0
(
    defaultPrim = "ConveyorPathSupport"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """One seam-free static triangle surface for the complete L conveyor path.

    The old main/corner/branch Cuboids met at co-planar butt joints.  Their
    hidden vertical end faces could catch a wide flat parcel exactly at the
    joint.  This single connected top mesh has no internal vertical faces.
    Both straight corridors are 0.60 m wide. Local origin: main-lane center X,
    main-belt north edge Y, belt top Z."""
)

def Xform "ConveyorPathSupport"
{
    def Material "BeltPhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    )
    {
        float physics:dynamicFriction = 0.6
        float physics:restitution = 0
        float physics:staticFriction = 0.8
        token physxMaterial:frictionCombineMode = "average"
        token physxMaterial:restitutionCombineMode = "average"
    }

    def Mesh "SupportSurface" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysicsMeshCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        bool doubleSided = 0
        float3[] extent = [(-11.4142, -8.03, 0), (0.30, 1.8834, 0)]
        int[] faceVertexCounts = [3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3]
        int[] faceVertexIndices = [
            0, 1, 3,
            0, 3, 2,
            4, 2, 6,
            4, 6, 5,
            2, 3, 7,
            2, 7, 6,
            5, 6, 9,
            5, 9, 8,
            6, 7, 10,
            6, 10, 9,
            11, 5, 8,
            11, 8, 12,
        ]
        point3f[] points = [
            (-0.30, -8.03, 0),
            (0.30, -8.03, 0),
            (-0.30, 0, 0),
            (0.30, 0, 0),
            (-1.40, 0, 0),
            (-1.40, 1.2834, 0),
            (-0.30, 1.2834, 0),
            (0.30, 1.2834, 0),
            (-1.40, 1.8834, 0),
            (-0.30, 1.8834, 0),
            (0.30, 1.8834, 0),
            (-11.4142, 1.2834, 0),
            (-11.4142, 1.8834, 0),
        ]
        bool physics:collisionEnabled = 1
        uniform token physics:approximation = "none"
        float physxCollision:contactOffset = 0.003
        float physxCollision:restOffset = 0
        rel material:binding:physics = </ConveyorPathSupport/BeltPhysicsMaterial>
        uniform token subdivisionScheme = "none"
        token visibility = "invisible"
    }
}
