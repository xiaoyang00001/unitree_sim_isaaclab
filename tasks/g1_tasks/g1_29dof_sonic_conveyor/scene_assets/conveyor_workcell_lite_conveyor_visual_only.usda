#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1.0
    upAxis = "Z"
    subLayers = [@./conveyor_workcell_lite.usd@]
)

over "Root"
{
    over "ConveyorBelt" (
        delete references = @./warehouse-simple6_v61_visual_only.usda@</Root/ConveyorBelt>
        prepend references = @./warehouse-simple6_v61_conveyor_visual_only.usda@</Root/ConveyorBelt>
    )
    {
    }
}
