#usda 1.0
(
    defaultPrim = "Root"
    # upAxis / metersPerUnit 是 stage metadata，只从 root layer 自身读取，不会从
    # subLayer 继承。不显式声明就会落到 USD 默认的 Y-up / 0.01(厘米)，单独打开本层
    # 时整个仓库会躺倒 90° 且尺度差 100 倍。运行时不受影响（本层是被 reference 挂到
    # Isaac 宿主 stage 上的，stage metadata 不参与组合），但 usdview / Isaac Sim 直接
    # 打开会看到错误的朝向，因此必须与 subLayer 源 warehouse-simple6_v61.usd 对齐。
    metersPerUnit = 1
    upAxis = "Z"
    subLayers = [
        @./warehouse-simple6_v61.usd@
    ]
)

# v61 把下列 10 个纸箱和 5 个 KLT 料箱作为动态三角网格刚体写进背景。它们只是布景，
# 不应进入任务物理、reset 或 scene-sync。本强层删除根 Prim 的物理 API，同时把根及
# 引用子 Prim 的碰撞/刚体开关显式关闭；即使上游资产以后重新添加 API，禁用属性仍
# 提供保护。
#
# 它们**同时被 active=false 整体摘除**，原因有二：
#   1. 摆位对不上带面。这批装饰物的坐标是 v48→v61 换版遗留：纸箱底 z=0.633 而带面
#      顶 0.772（陷进带里 14 cm，只露顶上 1 cm），料箱底 z=0.889~0.990（悬空
#      12~22 cm）。做布景时没人看，一旦旁边有真箱子就非常显眼。
#   2. 任务现在自己在工位上游 spawn 5 个真刚体纸箱（同款 SM_CardBoxD_01 视觉，见
#      scene_assets/props/cart_box_d01_physics.usda），沿带面精确贴合并参与
#      scene-sync。留着这批装饰物会和真箱子在同一条中线上视觉打架。
# 物理清理保留在原地而不是直接删掉整段：既是双保险，也保留了 active=true 时的可回退性。
over "Root"
{
    over "ConveyorBelt_Box_00" (
        active = false
        delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMassAPI", "PhysicsMeshCollisionAPI", "PhysicsRigidBodyAPI", "PhysxCollisionAPI", "PhysxRigidBodyAPI"]
    )
    {
        bool physics:collisionEnabled = 0
        bool physics:rigidBodyEnabled = 0

        over "SM_CardBoxD_01" (
            delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMassAPI", "PhysicsMeshCollisionAPI", "PhysicsRigidBodyAPI", "PhysxCollisionAPI", "PhysxRigidBodyAPI"]
        )
        {
            bool physics:collisionEnabled = 0
            bool physics:rigidBodyEnabled = 0
        }
    }

    over "ConveyorBelt_Box_01" (
        active = false
        delete apiSchemas = ["PhysicsCollisionAPI", "PhysicsMassAPI", "PhysicsMeshCollisionAPI", "PhysicsRigidBodyAPI", "PhysxCollisionAPI", "PhysxRigidBodyAPI"]
