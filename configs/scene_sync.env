# ============================================================
# Isaac-G1-29DoF-Sonic-Conveyor 双机场景同步配置
#
# 读取规则（单轨制）：进程环境变量永远优先，本文件的值只在
# 进程没设同名变量时作为默认值生效（os.environ.setdefault）。
# 两台机器请保持本文件同版本，只有 ISAACLAB_LOCAL_ROBOT_ID
# 和 ISAACLAB_SCENE_SYNC_PEER_IP 按机器各自设。
# ============================================================

# 本机身份：1 = 物体权威 + 复位权威（流水线驱动在这端跑）；2 = 镜像端。
# ⚠️ 故意不在共享文件里给默认值——两台机器同拷此文件时，漏设进程环境变量
# 会静默变成双权威裂脑。请在启动命令里按机各自 export：
#   ISAACLAB_LOCAL_ROBOT_ID=1   （或 2）

# 对端机器的 IP（同机双进程自测用 127.0.0.1）
ISAACLAB_SCENE_SYNC_PEER_IP=127.0.0.1

# 总开关：0 = 单机模式（不建 socket，物体保持动态、流水线照常驱动）
ISAACLAB_SCENE_SYNC=1

# 端口方案：bind = base + (本机ID-1)，connect = 对端同规则端口。
# ID=1 绑 15555、ID=2 绑 15556，同机双进程自测开箱即用。
ISAACLAB_SCENE_SYNC_PORT_BASE=15555
# 需要整条覆写时再放开：
# ISAACLAB_SCENE_SYNC_BIND_ENDPOINT=tcp://0.0.0.0:15555
# ISAACLAB_SCENE_SYNC_CONNECT_ENDPOINT=tcp://192.168.50.105:15556

# 同步挂载模式（本分支默认 1 = 方案 b 主循环挂载：deploy 断连/锁步暂停时
# 镜像仍活着；置 0 退回方案 a = ActionTerm 每物理步收发）
ISAACLAB_SCENE_SYNC_MAINLOOP=1

# 发布节流：方案 a 下 = 每 N 个物理步（200Hz）发一帧，4 = 50Hz；
# 方案 b 下主循环本身 50Hz，默认 1（不节流）
# ISAACLAB_SCENE_SYNC_PUBLISH_DECIMATION=1

# 镜像机器人后端：默认 articulation（已验路径）；visual_lod = 纯 USD Xform/FK，
# 不为 PeerRobot/PeerRobot2 注册 PhysX articulation、刚体、碰撞、执行器或接触上报。
# 动态联合验收完成前保持显式 opt-in；发布端也必须更新到携带 joint_names 的版本。
# ISAACLAB_PEER_ROBOT_MODE=visual_lod

# 场景布局：1 = 流水线布局（筐缩半在带上流动），0 = 原布局（筐叠拖车、搬上带自动送走）
ISAACLAB_TOTES_ON_CONVEYOR=1

# 流水线驱动微调（默认值即源分支实测值）
# ISAACLAB_CONVEYOR_SPEED=0.3
# ISAACLAB_CONVEYOR_Y_STOP=17.698   # 已含流水线整体北移 Δ=3.55（原 14.148）
# ISAACLAB_CONVEYOR_ENABLED=1

# 双机站位微调
# ISAACLAB_ROBOT_1_X=-4.75
# ISAACLAB_ROBOT_2_X=-6.7
# ISAACLAB_ROBOT_WORKSTATION_Y=17.698   # 同上（原 14.148）

# SONIC 底座若不认 yaw 180° 出生朝向（Phase 1 实测后定），置 1 兜底：
# ISAACLAB_ROBOT_YAW_IDENTITY=1
